//ACCTUPDJ JOB ,NOTIFY=&SYSUID
//*-----------------------------------------------------------
//* VSAM EXERCISE 5 - ACCOUNT MAINTENANCE (ADD, DEP, WDR, STS,
//* DEL) APPLIED TO Z79583.MY.ACCOUNTS.KSDS.
//* THIS JOB CHANGES THE KSDS. TO START AGAIN FROM THE ORIGINAL
//* 12 ACCOUNTS, RERUN JOB ACCTLOAD (EXERCISE 3) FIRST.
//*-----------------------------------------------------------
//* STEP 1: DELETE YESTERDAY'S BACKUP, IF ANY (IEFBR14 TRICK:
//*         MOD CREATES IT IF MISSING, THEN DELETE REMOVES IT)
//*-----------------------------------------------------------
//DELBKUP  EXEC PGM=IEFBR14
//BKUP     DD DSN=Z79583.MY.ACCOUNTS.BACKUP,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1))
//*-----------------------------------------------------------
//* STEP 2: BACK UP THE KSDS TO A SEQUENTIAL DATASET
//*         BEFORE ANY UPDATE. ALWAYS DO THIS IN REAL LIFE.
//*-----------------------------------------------------------
//BACKUP   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//BKUP     DD DSN=Z79583.MY.ACCOUNTS.BACKUP,
//            DISP=(NEW,CATLG,DELETE),SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=61,BLKSIZE=0)
//SYSIN    DD *
  REPRO INDATASET(Z79583.MY.ACCOUNTS.KSDS) OUTFILE(BKUP)
/*
//*-----------------------------------------------------------
//* STEP 3: COMPILE AND LINK ACCTUPD
//*-----------------------------------------------------------
//COMPLINK EXEC IGYWCL,COND=(4,LT)
//COBOL.SYSIN  DD DSN=Z79583.MY.COBOL(ACCTUPD),DISP=SHR
//LKED.SYSLMOD DD DSN=Z79583.MY.LOAD(ACCTUPD),DISP=SHR
//*-----------------------------------------------------------
//* STEP 4: APPLY THE TRANSACTIONS. LAYOUT IN COLUMNS:
//*   1-3 CODE   4-13 ACCOUNT   ADD: 4-64 FULL ACCOUNT RECORD
//*   DEP/WDR: 14-24 AMOUNT, NO DECIMAL POINT (00000250000 =
//*   2,500.00)   STS: 25 NEW STATUS (A/B/C)
//* EXPECTED: 12 READ, 1 ADDED, 4 UPDATED, 1 DELETED,
//*           6 REJECTED, RC 4
//*-----------------------------------------------------------
//RUN      EXEC PGM=ACCTUPD,COND=(4,LT)
//STEPLIB  DD DSN=Z79583.MY.LOAD,DISP=SHR
//ACCTFILE DD DSN=Z79583.MY.ACCOUNTS.KSDS,DISP=OLD
//SYSOUT   DD SYSOUT=*
//CEEDUMP  DD SYSOUT=*
//TRANIN   DD *
ADD1000000045NAVARRO LEON, PATRICIA        A0000050000020261019A
ADD1000000013RAMIREZ SILVA, ELENA          A0000010000020261019A
DEP100000000100000250000
WDR100000001700000054075
WDR100000002500000010000
WDR100000003700000900000
DEP100000009900000010000
STS1000000025           A
WDR100000002500000005000
DEL1000000033
DEL1000000041
XYZ100000000500000010000
/*
//*-----------------------------------------------------------
//* STEP 5: PRINT THE KSDS AFTER THE UPDATES (13 - 1 = 12 RECS)
//*-----------------------------------------------------------
//PRINT    EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  PRINT INDATASET(Z79583.MY.ACCOUNTS.KSDS) CHARACTER
/*
