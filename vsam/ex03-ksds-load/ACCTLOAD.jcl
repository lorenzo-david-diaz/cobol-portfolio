//ACCTLOAD JOB ,NOTIFY=&SYSUID
//*-----------------------------------------------------------
//* VSAM EXERCISE 3 - DEFINE THE ACCOUNTS KSDS AND LOAD IT
//* RECORD LAYOUT (61 BYTES) = CAPSTONE ACCOUNTS LAYOUT:
//*   1-10 ACCOUNT NUMBER (KEY)    11-40 HOLDER NAME
//*   41   ACCOUNT TYPE  A/C       42-52 BALANCE 9(9)V99
//*   53-60 OPEN DATE YYYYMMDD     61    STATUS A/B/C
//*-----------------------------------------------------------
//* STEP 1: DEFINE THE KSDS (DELETE FIRST SO THE JOB CAN BE
//*         RERUN; SET MAXCC = 0 IGNORES "NOT FOUND")
//*-----------------------------------------------------------
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE Z79583.MY.ACCOUNTS.KSDS CLUSTER PURGE
  SET MAXCC = 0
  DEFINE CLUSTER (NAME(Z79583.MY.ACCOUNTS.KSDS)      -
         INDEXED                                    -
         KEYS(10 0)                                 -
         RECORDSIZE(61 61)                          -
         FREESPACE(10 10)                           -
         SHAREOPTIONS(2 3)                          -
         TRACKS(1 1))                               -
         DATA  (NAME(Z79583.MY.ACCOUNTS.KSDS.DATA)) -
         INDEX (NAME(Z79583.MY.ACCOUNTS.KSDS.INDEX))
/*
//*-----------------------------------------------------------
//* STEP 2: SORT THE INPUT BY ACCOUNT NUMBER AND CUT EACH
//*         RECORD TO 61 BYTES. A KSDS MUST BE LOADED IN KEY
//*         ORDER. THE INPUT BELOW IS DELIBERATELY UNSORTED.
//*-----------------------------------------------------------
//SORTACCT EXEC PGM=SORT,COND=(4,LT)
//SYSOUT   DD SYSOUT=*
//SORTOUT  DD DSN=&&ACCOUNTS,DISP=(NEW,PASS),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=61
//SYSIN    DD *
  SORT FIELDS=(1,10,CH,A)
  OUTREC BUILD=(1,61)
/*
//SORTIN   DD *
1000000017MARQUEZ ROJAS, ANDREINA       C0000125407520190312A
1000000003HERNANDEZ FLORES, FRANCISCO   A0000458002020150605A
1000000025SALAZAR PINTO, RAFAEL         A0000009805020231120B
1000000009OCHOA VARGAS, GABRIELA        C0000231000020170228A
1000000041BRICENO LUGO, CARMEN          A0001500000020120717A
1000000011ACOSTA MENDEZ, ALBERTO        A0000073559020200901A
1000000033GUERRA SUAREZ, LUIS           C0000000000020100115C
1000000005TORRES TORRES, ANTONIO        C0000199999920181004A
1000000029CASTILLO ROJAS, MIGUEL        A0000642001020210630A
1000000001DIAZ MENDOZA, LUISA           A0000300000020140210A
1000000037PEREZ GOMEZ, EDUARDO          C0000051234520240822A
1000000013RAMIREZ SILVA, ELENA          A0000887506020160413A
/*
//*-----------------------------------------------------------
//* STEP 3: LOAD THE KSDS, PRINT IT AND SHOW THE CATALOG ENTRY
//*-----------------------------------------------------------
//LOAD     EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//SEQIN    DD DSN=&&ACCOUNTS,DISP=(OLD,DELETE)
//SYSIN    DD *
  REPRO INFILE(SEQIN) OUTDATASET(Z79583.MY.ACCOUNTS.KSDS)
  PRINT INDATASET(Z79583.MY.ACCOUNTS.KSDS) CHARACTER
  LISTCAT ENTRIES(Z79583.MY.ACCOUNTS.KSDS) ALL
/*
